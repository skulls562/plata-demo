  "private": true,
  "scripts": {
    "dev": "node scripts/next-demo.mjs dev -H 127.0.0.1 -p 3010",
    "build": "node scripts/next-demo.mjs build",
    "start": "node scripts/next-demo.mjs start -H 127.0.0.1 -p 3010",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node --disable-warning=ExperimentalWarning scripts/ejecutar-ts.mjs scripts/sembrar-demo.ts",
    "e2e": "playwright test",
